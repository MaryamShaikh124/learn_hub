ADMIN_NAME=replace-with-admin-name
ADMIN_EMAIL=replace-with-admin-email
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
VITE_SERVER_LINK=add-server-link-here
CLIENT_URL=add-client-link-here